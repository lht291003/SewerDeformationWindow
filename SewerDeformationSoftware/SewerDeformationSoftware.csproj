<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<OutputType>WinExe</OutputType>
		<LangVersion>14.0</LangVersion>
		<TargetFramework>Net10.0-Windows10.0.22621.0</TargetFramework>
		<Nullable>Enable</Nullable>
		<ImplicitUsings>Enable</ImplicitUsings>
		<UseWPF>True</UseWPF>
		<UseWindowsForms>False</UseWindowsForms>
		<ApplicationIcon>Images\Ico.ico</ApplicationIcon>
		<BaseOutputPath>Binary\</BaseOutputPath>
		<SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Images\BuildImg.svg" />
		<None Remove="Images\FilesImg.svg" />
		<None Remove="Images\Ico.ico" />
		<None Remove="Images\ModelImg.svg" />
		<None Remove="Images\PhotoImg.svg" />
		<None Remove="Images\VideoImg.svg" />
	</ItemGroup>
	<ItemGroup>
		<Resource Include="Images\BuildImg.svg" />
		<Resource Include="Images\FilesImg.svg" />
		<Resource Include="Images\Ico.ico" />
		<Resource Include="Images\ModelImg.svg" />
		<Resource Include="Images\PhotoImg.svg" />
		<Resource Include="Images\VideoImg.svg" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="EPPlus" Version="8.7.2" />
		<PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
		<PackageReference Include="YoloSharp.Core" Version="6.1.1" />
		<PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
		<PackageReference Include="Extended.Wpf.Toolkit" Version="5.1.2" />
		<PackageReference Include="MaterialDesignThemes" Version="5.4.0" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.161" />
		<PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" Version="1.26.0" />
	</ItemGroup>

</Project>