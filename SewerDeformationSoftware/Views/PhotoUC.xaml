<UserControl 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    X:Class="SewerDeformationSoftware.Views.PhotoUC"
    xmlns:X="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:D="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:MD="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:I="http://schemas.microsoft.com/xaml/behaviors" MC:Ignorable="D"
    xmlns:MC="http://schemas.openxmlformats.org/markup-compatibility/2006"
    D:DesignHeight="650" D:DesignWidth="975"
    DataContext="{StaticResource PhotoDBC}">
    <ScrollViewer Background="White" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50.0"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10.0"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <MD:Card
                        UniformCornerRadius="3"
                        AllowDrop="True"
                        Background="#F0F4F9">
                        <I:Interaction.Triggers>
                            <I:EventTrigger EventName="Drop">
                                <I:InvokeCommandAction Command="{Binding Dragop}" PassEventArgsToCommand="True"/>
                            </I:EventTrigger>
                        </I:Interaction.Triggers>
                        <Grid
                            Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>
                            <Image
                                Source="/Images/FilesImg.png" Height="50"/>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Text="Kéo và thả hình ảnh của bạn"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold" FontSize="15"/>
                                <TextBlock
                                    Grid.Row="1" VerticalAlignment="Center">
                                    Loại hình ảnh:
                                    <Italic>
                                        <Bold>
                                            PNG, JPG, WEBP, JPEG, BMP, TIFF
                                        </Bold>
                                    </Italic>
                                </TextBlock>
                            </Grid>
                            <Button
                                Content="Browse"
                                Grid.Column="4"
                                Height="50.00" Command="{Binding Browse}"/>
                        </Grid>
                    </MD:Card>
                    <Grid Visibility="{Binding PhotoName, Converter={StaticResource Text2Vision}}" Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10.0"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10.0"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid
                            Margin="10.0"
                            Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>
                            <Image
                                Source="/Images/PhotoImg.png" Height="50"/>
                            <TextBlock
                                Text="{Binding PhotoName}"
                                VerticalAlignment="Center"
                                Grid.Column="2"
                                FontWeight="ExtraBlack"/>
                            <Button
                                Content="Remove"
                                Grid.Column="4"
                                Height="50.00" Command="{Binding Remove}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>