<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    X:Class="SewerDeformationSoftware.Views.WaitIndicator"
    xmlns:X="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeToContent="WidthAndHeight" WindowStyle="None" ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Cursor="Wait"
    Background="Transparent"
    AllowsTransparency="True">
    <Border
        Background="#F0F4F9"
        CornerRadius="5.0"
        BorderThickness="1.0">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10.0"/>
                <ColumnDefinition Width="1.0*"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Height="75" Width="75" IsIndeterminate="True"/>
            <TextBlock FontSize="20.0000" FontWeight="ExtraBlack" Grid.Column="2" VerticalAlignment="Center" Text="Đang xử lý..."/>
        </Grid>
    </Border>
</Window>