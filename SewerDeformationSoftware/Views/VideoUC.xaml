<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    X:Class="SewerDeformationSoftware.Views.VideoUC"
    xmlns:X="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:D="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:MD="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:I="http://schemas.microsoft.com/xaml/behaviors" MC:Ignorable="D"
    xmlns:MC="http://schemas.openxmlformats.org/markup-compatibility/2006"
    D:DesignHeight="650" D:DesignWidth="1050"
    DataContext="{StaticResource VideoDBC}">
    <ScrollViewer Background="White" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50.0"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10.0"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <MD:Card
                        UniformCornerRadius="5"
                        AllowDrop="True"
                        Background="#F0F4F9">
                        <I:Interaction.Triggers>
                            <I:EventTrigger EventName="Drop">
                                <I:InvokeCommandAction Command="{Binding Dragop}" PassEventArgsToCommand="True"/>
                            </I:EventTrigger>
                        </I:Interaction.Triggers>
                        <Grid
                            Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>
                            <Image
                                Source="/Images/FilesImg.png" Height="50"/>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Text="Kéo và thả video của bạn"
                                    FontWeight="Bold" FontSize="14"
                                    VerticalAlignment="Center"/>
                                <TextBlock
                                    Grid.Row="1" VerticalAlignment="Center">
                                    Loại video:
                                    <Italic>
                                        <Bold>
                                            MP4, MOV, WEBM
                                        </Bold>
                                    </Italic>
                                </TextBlock>
                            </Grid>
                            <Button
                                Content="Browse"
                                Grid.Column="4"
                                Height="50.00" Command="{Binding Browse}"/>
                        </Grid>
                    </MD:Card>
                    <Grid Visibility="{Binding VideoName, Converter={StaticResource None2Hidden}}" Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10.0"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10.0"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid
                            Margin="10.0"
                            Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>
                            <Image
                                Source="/Images/VideoImg.png" Height="50"/>
                            <TextBlock
                                Text="{Binding VideoName}"
                                VerticalAlignment="Center"
                                Grid.Column="2"
                                FontWeight="ExtraBlack"/>
                            <Button
                                Content="Remove"
                                Grid.Column="4"
                                Height="50.00" Command="{Binding Remove}"/>
                        </Grid>
                        <Grid
                            Margin="10 20 10 10" Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10.0"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10.0"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Slider
                                TickFrequency="10"
                                Cursor="SizeWE" Maximum="100" Minimum="00" Value="{Binding Distance}"
                                MD:SliderAssist.ToolTipFormat="Khoảng cách giữa hai khung hình:[{0}]"
                                Style="{StaticResource MaterialDesign3.MaterialDesignDiscreteSlider}"
                                Visibility="{Binding IsCommenced, Converter={StaticResource Bool2Vision}, ConverterParameter='Began'}"/>
                            <Button
                                Content="Chạy suy luận video"
                                Height="050" IsDefault="True"
                                Command="{Binding Accept}" Grid.Row="2" Background="#3F51B5"
                                Visibility="{Binding IsCommenced, Converter={StaticResource Bool2Vision}, ConverterParameter='Began'}"/>
                            <Button
                                Content="Dừng suy luận video"
                                Height="050" IsDefault="True"
                                Command="{Binding CutOff}" Grid.Row="4" Background="#FF0000"
                                Visibility="{Binding IsCommenced, Converter={StaticResource Bool2Vision}, ConverterParameter='Break'}"/>
                        </Grid>
                        <Grid
                            Margin="10.0"
                            Grid.Row="4">
                            <Grid.Resources>
                                <Style TargetType="MD:Card" X:Key="Section">
                                    <Setter Property="UniformCornerRadius" Value="5.00000"/>
                                    <Setter Property="Background" Value="CornflowerBlue"/>
                                </Style>
                                <Style TargetType="TextBlock" X:Key="Label">
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                                <Style TargetType="TextBlock" X:Key="Value">
                                    <Setter Property="FontSize" Value="20"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10.0"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <MD:Card
                                UniformCornerRadius="5"
                                Grid.Row="0"
                                Background="#F0F4F9">
                                <Expander
                                    MD:ExpanderAssist.HorizontalHeaderPadding="10">
                                    <Expander.Header>
                                        <TextBlock
                                            Text="Dự đoán với khung hình hiện tại"
                                            FontSize="17" FontWeight="UltraBold"/>
                                    </Expander.Header>
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10.0"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Visibility="{Binding NPltImage, Converter={StaticResource None2Hidden}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5.00"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Ảnh phân đoạn hiện tại" FontSize="16" FontWeight="SemiBold"/>
                                                <Grid Grid.Row="2">
                                                    <Border
                                                        X:Name="MaskOverlayOnImage1" Background="White" CornerRadius="05"/>
                                                    <Image
                                                        Source="{Binding NPltImage, Converter={StaticResource None2Unbind}}">
                                                        <Image.OpacityMask>
                                                            <VisualBrush Visual="{Binding ElementName=MaskOverlayOnImage1}"/>
                                                        </Image.OpacityMask>
                                                    </Image>
                                                </Grid>
                                            </Grid>
                                            <Grid Grid.Column="2" Visibility="{Binding MaskImage, Converter={StaticResource None2Hidden}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5.00"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Mặt nạ được trực quan" FontSize="16" FontWeight="SemiBold"/>
                                                <Grid Grid.Row="2">
                                                    <Border
                                                        X:Name="MaskOverlayOnImage2" Background="White" CornerRadius="05"/>
                                                    <Image
                                                        Source="{Binding MaskImage, Converter={StaticResource None2Unbind}}">
                                                        <Image.OpacityMask>
                                                            <VisualBrush Visual="{Binding ElementName=MaskOverlayOnImage2}"/>
                                                        </Image.OpacityMask>
                                                    </Image>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                        <Grid Grid.Row="2"
                                              Margin="0,0,0,0.00" Visibility="{Binding MaskImage, Converter={StaticResource None2Hidden}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="5.00"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Text="Kết quả trả về"
                                                FontWeight="SemiBold"
                                                FontSize="016"/>
                                            <Grid Grid.Row="02">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="5"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="5.00"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="5.00"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <MD:Card Grid.Row="0"
                                                             Style="{StaticResource Section}">
                                                        <Grid Margin="10">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="20.0"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="20.0"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock
                                                                Grid.Row="00" Text="AspectRatio"
                                                                Style="{StaticResource Label}"/>
                                                            <TextBlock Grid.Row="2" Text="{Binding AspectRatio}" Style="{StaticResource Value}"/>
                                                        </Grid>
                                                    </MD:Card>
                                                    <MD:Card Grid.Row="2"
                                                             Style="{StaticResource Section}">
                                                        <Grid Margin="10">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="20.0"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="20.0"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock
                                                                Grid.Row="00" Text="Deformation"
                                                                Style="{StaticResource Label}"/>
                                                            <TextBlock Grid.Row="2" Text="{Binding Deformation}" Style="{StaticResource Value}"/>
                                                        </Grid>
                                                    </MD:Card>
                                                    <MD:Card Grid.Row="4"
                                                             Style="{StaticResource Section}">
                                                        <Grid Margin="10">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="20.0"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="20.0"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock
                                                                Grid.Row="00" Text="Orientation"
                                                                Style="{StaticResource Label}"/>
                                                            <TextBlock Grid.Row="2" Text="{Binding Orientation}" Style="{StaticResource Value}"/>
                                                        </Grid>
                                                    </MD:Card>
                                                </Grid>
                                                <Grid Grid.Column="2">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="5.00"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <MD:Card Grid.Row="0"
                                                             Style="{StaticResource Section}">
                                                        <Grid Margin="10">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="20.0"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="20.0"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock
                                                                Grid.Row="0"
                                                                Text="Shape"
                                                                Style="{StaticResource Label}"/>
                                                            <TextBlock
                                                                Grid.Row="2"
                                                                Text="{Binding Shape}"
                                                                Style="{StaticResource Value}"/>
                                                        </Grid>
                                                    </MD:Card>
                                                    <MD:Card Grid.Row="2"
                                                             Style="{StaticResource Section}">
                                                        <Grid Margin="10">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="20.0"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="20.0"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock
                                                                Grid.Row="0"
                                                                Text="State"
                                                                Style="{StaticResource Label}"/>
                                                            <TextBlock
                                                                Grid.Row="2"
                                                                Text="{Binding State}"
                                                                Style="{StaticResource Value}"/>
                                                        </Grid>
                                                    </MD:Card>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Expander>
                            </MD:Card>
                            <MD:Card
                                UniformCornerRadius="5"
                                Grid.Row="2"
                                Background="#F0F4F9">
                                <Expander
                                    MD:ExpanderAssist.HorizontalHeaderPadding="10">
                                    <Expander.Header>
                                        <TextBlock
                                            Text="So sánh với khung hình trước đó"
                                            FontSize="17" FontWeight="ExtraBold"/>
                                    </Expander.Header>
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10.0"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Visibility="{Binding NPltImage, Converter={StaticResource None2Hidden}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5.00"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Ảnh phân đoạn hiện tại" FontSize="16" FontWeight="SemiBold"/>
                                                <Grid Grid.Row="2">
                                                    <Border
                                                        X:Name="MaskOverlayOnImage3" Background="White" CornerRadius="05"/>
                                                    <Image
                                                        Source="{Binding NPltImage, Converter={StaticResource None2Unbind}}">
                                                        <Image.OpacityMask>
                                                            <VisualBrush Visual="{Binding ElementName=MaskOverlayOnImage3}"/>
                                                        </Image.OpacityMask>
                                                    </Image>
                                                </Grid>
                                            </Grid>
                                            <Grid Grid.Column="2" Visibility="{Binding PPltImage, Converter={StaticResource None2Hidden}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5.00"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Ảnh phân đoạn trước đó" FontSize="16" FontWeight="SemiBold"/>
                                                <Grid Grid.Row="2">
                                                    <Border
                                                        X:Name="MaskOverlayOnImage4" Background="White" CornerRadius="05"/>
                                                    <Image
                                                        Source="{Binding PPltImage, Converter={StaticResource None2Unbind}}">
                                                        <Image.OpacityMask>
                                                            <VisualBrush Visual="{Binding ElementName=MaskOverlayOnImage4}"/>
                                                        </Image.OpacityMask>
                                                    </Image>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="5.00"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Text="Kết quả trả về"
                                                FontWeight="SemiBold"
                                                FontSize="016"/>
                                            <Grid Grid.Row="02">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="5"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="5.00"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <MD:Card Grid.Row="0"
                                                        Style="{StaticResource Section}">
                                                        <Grid Margin="10">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="20.0"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="20.0"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock
                                                                Grid.Row="00" Text="Resemblance"
                                                                Style="{StaticResource Label}"/>
                                                            <TextBlock Grid.Row="2" Text="{Binding Resemblance}" Style="{StaticResource Value}"/>
                                                        </Grid>
                                                    </MD:Card>
                                                    <MD:Card Grid.Row="2"
                                                             Style="{StaticResource Section}">
                                                        <Grid Margin="10">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="20.0"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="20.0"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock
                                                                Grid.Row="00" Text="Distinction"
                                                                Style="{StaticResource Label}"/>
                                                            <TextBlock Grid.Row="2" Text="{Binding Distinction}" Style="{StaticResource Value}"/>
                                                        </Grid>
                                                    </MD:Card>
                                                </Grid>
                                                <Grid Grid.Column="2">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="5.00"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <MD:Card Grid.Row="0"
                                                             Style="{StaticResource Section}">
                                                        <Grid Margin="10">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="20.0"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="20.0"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock
                                                                Grid.Row="0"
                                                                Text="Delta"
                                                                Style="{StaticResource Label}"/>
                                                            <TextBlock
                                                                Grid.Row="2"
                                                                Text="{Binding Delta}"
                                                                Style="{StaticResource Value}"/>
                                                        </Grid>
                                                    </MD:Card>
                                                    <MD:Card Grid.Row="2"
                                                             Style="{StaticResource Section}">
                                                        <Grid Margin="10">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="20.0"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="20.0"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock
                                                                Grid.Row="0"
                                                                Text="Phase"
                                                                Style="{StaticResource Label}"/>
                                                            <TextBlock
                                                                Grid.Row="2"
                                                                Text="{Binding Phase}"
                                                                Style="{StaticResource Value}"/>
                                                        </Grid>
                                                    </MD:Card>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Expander>
                            </MD:Card>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>