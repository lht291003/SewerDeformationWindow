<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    X:Class="SewerDeformationSoftware.Views.BuildUC"
    xmlns:X="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:D="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:MD="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:I="http://schemas.microsoft.com/xaml/behaviors" MC:Ignorable="D"
    xmlns:MC="http://schemas.openxmlformats.org/markup-compatibility/2006"
    D:DesignHeight="650" D:DesignWidth="1050"
    DataContext="{StaticResource BuildDBC}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10.0"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <MD:Card UniformCornerRadius="5" Background="#E6E6E6">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="95"/>
                        </Grid.ColumnDefinitions>
                        <Image
                            Source="/Images/FilesImg.png" Height="50"/>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock
                                Text="Kéo và thả mô hình của bạn"
                                VerticalAlignment="Center"
                                FontWeight="Bold" FontSize="15"/>
                            <TextBlock
                                Grid.Row="1" VerticalAlignment="Center">
                                Loại mô hình:
                                <Italic>
                                    <Bold>
                                        ONNX
                                    </Bold>
                                </Italic>
                            </TextBlock>
                        </Grid>
                        <Button
                            Content="Browse"
                            Grid.Column="4"
                            Height="50.00" Command="{Binding Browse}"/>
                    </Grid>
                </MD:Card>
                <Grid Visibility="{Binding ModelName, Converter={StaticResource Text2Vision}}" Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10.0"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10.0"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid
                        Margin="10.0"
                        Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="95"/>
                        </Grid.ColumnDefinitions>
                        <Image
                            Source="/Images/ModelImg.png" Height="50"/>
                        <TextBlock
                            Text="{Binding ModelName}"
                            VerticalAlignment="Center"
                            Grid.Column="2"
                            FontWeight="ExtraBlack"/>
                        <Button
                            Content="Remove"
                            Grid.Column="4"
                            Height="50.00" Command="{Binding Remove}"/>
                    </Grid>
                    <Grid
                        Margin="10.0"
                        Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10.0"/>
                            <ColumnDefinition Width="1.0*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="Loại phần cứng chạy suy luận"
                            FontSize="13" FontWeight="SemiBold"
                            VerticalAlignment="Center"/>
                        <StackPanel
                            Grid.Column="2" Orientation="Horizontal">
                            <RadioButton Content="Mặc định (CPU)" GroupName="Hardware"
                                         IsChecked="{Binding GetDevice, Converter={StaticResource Radios2Text}, ConverterParameter='CPU'}"/>
                            <RadioButton Content="GPU (Mặc định)" GroupName="Hardware"
                                         IsChecked="{Binding GetDevice, Converter={StaticResource Radios2Text}, ConverterParameter='GPU'}"/>
                            <RadioButton Content="GPU (TensorRT)" GroupName="Hardware"
                                         IsChecked="{Binding GetDevice, Converter={StaticResource Radios2Text}, ConverterParameter='TRT'}"/>
                        </StackPanel>
                    </Grid>
                    <Grid
                        Margin="10.0"
                        Grid.Row="4">
                        <Button Content="Xây dựng mô hình" Command="{Binding Accept}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>