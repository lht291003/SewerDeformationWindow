<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    X:Class="SewerDeformationSoftware.Views.BuildUC"
    xmlns:X="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:D="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:MD="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:I="http://schemas.microsoft.com/xaml/behaviors" MC:Ignorable="D"
    xmlns:MC="http://schemas.openxmlformats.org/markup-compatibility/2006"
    D:DesignHeight="650" D:DesignWidth="1050"
    DataContext="{StaticResource BuildDBC}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10.0"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <MD:Card UniformCornerRadius="5" Background="#E6E6E6">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="95"/>
                        </Grid.ColumnDefinitions>
                        <Image
                            Source="/Images/FilesImg.png" Height="50"/>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock
                                Text="Tải lên mô hình để xây dựng"
                                VerticalAlignment="Center"
                                FontWeight="Bold" FontSize="15"/>
                            <TextBlock
                                Grid.Row="1" VerticalAlignment="Center">
                                Mô hình được hỗ trợ:
                                <Italic>
                                    <Bold>
                                        ONNX, ENGINE
                                    </Bold>
                                </Italic>
                            </TextBlock>
                        </Grid>
                        <Button
                            Content="Browse"
                            Grid.Column="4"
                            Height="50.0"/>
                    </Grid>
                </MD:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>